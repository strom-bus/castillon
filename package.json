{
  "name": "castillon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "measure": "vite --open /measure.html",
    "og": "esbuild src/tools/ogImage.run.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/og.mjs --log-level=warning && node node_modules/.cache/og.mjs",
    "stress": "npx vite-node src/tools/writeStressPatch.ts",
    "size": "npx vite-node src/tools/checkSize.ts",
    "deploy:worker": "npx wrangler deploy",
    "check:service": "npx vite-node src/tools/checkService.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "description": "Sintetizador modular por nodos con ejecuci\u00f3n en cascada",
  "license": "AGPL-3.0-only",
  "author": "Wilhelm Sch\u00fctze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strom-bus/castillon.git"
  }
}
